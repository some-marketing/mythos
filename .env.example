# Copy to .env for local use. Do not commit real secrets or private account values.

# Optional: Perplexity web-research CLI (tools/perplexity). Get a key at
# https://www.perplexity.ai (Settings -> API). Frameworks skip the research
# leg gracefully if this is unset.
PERPLEXITY_API_KEY=

# Browser automation state (site-audit verification). Defaults should use
# temp paths, not personal profiles.
PLAYWRIGHT_STORAGE_STATE=/tmp/mythos/storage-state.json
PLAYWRIGHT_USER_DATA_DIR=/tmp/mythos/playwright-user-data

# Local path overrides
PROJECT_ROOT=/path/to/mythos
ARTIFACT_ROOT=/tmp/mythos/artifacts
LOCAL_ASSET_DIR=/tmp/mythos/assets
