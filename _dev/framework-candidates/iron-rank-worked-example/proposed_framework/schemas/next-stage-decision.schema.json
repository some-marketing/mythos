  "title": "Staged Remediation Next Stage Decision",
  "type": "object",
  "required": [
    "current_stage_id",
    "current_stage_status",
    "ready_for_next_stage",
    "recommended_next_stage_id",
    "reason",
    "blockers",
    "deferred_by_design"
  ],
  "properties": {
    "current_stage_id": { "type": "string" },
    "current_stage_status": { "type": "string" },
    "ready_for_next_stage": { "type": "boolean" },
    "recommended_next_stage_id": { "type": "string" },
    "reason": { "type": "string" },
    "blockers": { "type": "array" },
    "deferred_by_design": { "type": "array" }
  }
}

