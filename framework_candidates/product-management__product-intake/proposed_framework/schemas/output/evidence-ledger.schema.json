{
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "claim",
      "classification",
      "provenance",
      "limitations"
    ],
    "properties": {
      "claim": { "type": "string", "minLength": 1, "pattern": "\\S" },
      "classification": {
        "type": "string",
        "enum": [
          "observation",
          "stakeholder_claim",
          "interpretation",
          "assumption",
          "open_question"
        ]
      },
      "provenance": { "type": "string", "minLength": 1, "pattern": "\\S" },
      "limitations": { "type": "array", "items": { "type": "string" } }
    }
  }
}
