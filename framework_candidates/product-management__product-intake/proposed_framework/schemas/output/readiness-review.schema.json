          "stage": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "reviewer_provenance": {
      "type": "object",
      "required": [
        "actor_id",
        "harness_id",
        "model_provider_family"
      ],
      "properties": {
        "actor_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "harness_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
