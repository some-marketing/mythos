{
  "type": "object",
  "required": [
    "baseline_inventory",
    "change_proposal",
    "delta_spec",
    "dependency_acceptance_map",
    "review"
  ],
  "properties": {
    "baseline_inventory": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "change_proposal": {
      "type": "object"
    },
    "delta_spec": {
      "type": "object",
      "required": [
        "added",
        "modified",
        "removed",
        "preserved_invariants"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["requirement_id", "requirement", "scenarios"],
            "properties": {
              "requirement_id": { "type": "string", "minLength": 1 },
              "requirement": { "type": "string", "minLength": 1 },
              "scenarios": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["requirement_id", "baseline_requirement_id", "behavioral_difference", "requirement", "scenarios"],
            "properties": {
              "requirement_id": { "type": "string", "minLength": 1 },
              "baseline_requirement_id": { "type": "string", "minLength": 1 },
              "behavioral_difference": { "type": "string", "minLength": 1 },
              "requirement": { "type": "string", "minLength": 1 },
              "scenarios": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["requirement_id", "baseline_requirement_id", "intended_absence"],
            "properties": {
              "requirement_id": { "type": "string", "minLength": 1 },
              "baseline_requirement_id": { "type": "string", "minLength": 1 },
              "intended_absence": { "type": "string", "minLength": 1 }
            }
          }
        },
        "preserved_invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dependency_acceptance_map": {
      "type": "object",
      "required": [
        "read_first",
        "dependencies",
        "acceptance_criteria"
      ],
      "properties": {
        "read_first": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["delta_id", "depends_on", "rationale"],
            "properties": {
              "delta_id": { "type": "string", "minLength": 1 },
              "depends_on": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["criterion_id", "delta_id", "condition", "observable_result"],
            "properties": {
              "criterion_id": { "type": "string", "minLength": 1 },
              "delta_id": { "type": "string", "minLength": 1 },
              "condition": { "type": "string", "minLength": 1 },
              "observable_result": { "type": "string", "minLength": 1 }
            }
          }
        },
        "waves": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "verdict",
        "findings",
        "falsifier"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "PASS",
            "CONCERNS",
            "FAIL"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "falsifier": {
          "type": "string"
        }
      }
    }
  }
}
