{
  "type": "object",
  "required": [
    "read_first",
    "dependencies",
    "acceptance_criteria"
  ],
  "properties": {
    "read_first": { "type": "array", "items": { "type": "string" } },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["delta_id", "depends_on", "rationale"],
        "properties": {
          "delta_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "depends_on": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
          "rationale": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion_id", "delta_id", "condition", "observable_result"],
        "properties": {
          "criterion_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "delta_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "condition": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "observable_result": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "waves": { "type": "array", "items": { "type": "object" } }
  }
}
