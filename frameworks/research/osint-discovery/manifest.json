{
  "service_category":"research",
  "framework_name":"osint-discovery",
  "version":"0.1.0",
  "description":"Route lawful public-source discovery for a bounded target at any research scope.",
  "prompt_count":4,
  "input_contract":{"required":[{"name":"target","description":"The organization, domain, project, technology, event, or authorized person-related target"},{"name":"purpose","description":"Why the discovery is being performed"}],"optional":[{"name":"jurisdiction","description":"Relevant country, region, or sector"},{"name":"known_identifiers","description":"Operator-supplied public identifiers"}]},
  "output_contract":{"directories":["outputs/osint-discovery/"],"artifacts":["outputs/osint-discovery/discovery-report.json","outputs/osint-discovery/evidence-log.json"]},
  "output_contract_v2":{"directories":[{"path":"outputs/osint-discovery/","required":true,"description":"Bounded public-source discovery bundle"}],"artifacts":[{"name":"discovery-report.json","path_pattern":"outputs/osint-discovery/discovery-report.json","required":true},{"name":"evidence-log.json","path_pattern":"outputs/osint-discovery/evidence-log.json","required":true}],"bundle_types":[]},
  "execution_modes":["FINDINGS_ONLY","REVIEW_ONLY"],
  "mcp_requirements":[],
  "prompt_chain":{"scope":["01_SCOPE"],"planning":["02_SOURCE_PLAN"],"discovery":["03_DISCOVERY"],"synthesis":["04_SYNTHESIS"]},
  "skills":["osint-discovery/SKILL.md"],
  "commands":["run","status","scope","source-plan","discovery","synthesis"],
  "agents":["scope-agent","source-plan-agent","discovery-agent","synthesis-agent"]
}
