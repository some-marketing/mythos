{
  "service_category": "wordpress",
  "framework_name": "qa",
  "version": "1.1.0",
  "changelog": [
    "1.1.0: CRM pipeline integrity discipline + currency/handoff gates"
  ],
  "description": "Playwright-based site functionality testing across multi-environment pipelines with CRM integration validation",
  "prompt_count": 16,
  "input_contract": {
    "required": [
      {
        "name": "testcase.json",
        "description": "Test configuration with run sequence and phase definitions"
      },
      {
        "name": "identity.json",
        "description": "Email and token templates per environment"
      },
      {
        "name": "locator_map.json",
        "description": "CSS/XPath selectors for form elements"
      },
      {
        "name": "EXPECTED_OUTCOMES.md",
        "description": "Test specifications and success criteria"
      }
    ],
    "optional": [
      {
        "name": "config.json",
        "description": "Runner configuration overrides"
      }
    ]
  },
  "output_contract": {
    "directories": [
      "runs/",
      "reports/",
      "dev_handoff/"
    ],
    "artifacts": [
      "run.meta.json",
      "environment reports",
      "payload reports",
      "dev handoff bundles"
    ]
  },
  "output_contract_v2": {
    "directories": [
      {
        "path": "runs/",
        "required": true,
        "description": "Test run output directories"
      },
      {
        "path": "reports/",
        "required": true,
        "description": "Canonical payload and analysis reports"
      },
      {
        "path": "dev_handoff/",
        "required": false,
        "description": "Developer handoff bundles"
      }
    ],
    "artifacts": [
      {
        "name": "run.meta.json",
        "path_pattern": "runs/**/run.meta.json",
        "required": true
      }
    ],
    "bundle_types": [
      {
        "type_id": "dev-handoff-bundle",
        "path_pattern": "dev_handoff/DEV_HANDOFF__*",
        "required_files": [
          "LLM_MANIFEST.json",
          "INDEX.json",
          "INDEX.md",
          "SUMMARY.json",
          "QUESTIONS_FOR_DEVELOPER.md"
        ],
        "required_file_patterns": [
          "For_*.md"
        ],
        "required_directories": [
          "reports/",
          "raw/",
          "evidence/",
          "llm/"
        ],
        "file_schemas": {
          "LLM_MANIFEST.json": "llm-manifest.schema.json",
          "INDEX.json": "index-json.schema.json",
          "SUMMARY.json": "summary-json.schema.json"
        },
        "description": "Developer handoff bundle with payload analysis, evidence, and agent harness"
      }
    ]
  },
  "execution_modes": [
    "FINDINGS_ONLY",
    "RUN_ONLY",
    "REVIEW_ONLY",
    "PATCH_ALLOWED",
    "COORDINATOR",
    "REPO_HYGIENE"
  ],
  "mcp_requirements": [
    "playwright"
  ],
  "prompt_chain": {
    "intake": [
      "01_INTAKE_AND_SCAFFOLD"
    ],
