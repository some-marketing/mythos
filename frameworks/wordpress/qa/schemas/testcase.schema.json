{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Testcase Configuration",
  "type": "object",
  "required": ["testcase_id", "target_url", "environments", "phases"],
  "properties": {
    "testcase_id": {"type": "string", "description": "Unique testcase identifier"},
    "description": {"type": "string"},
    "target_url": {"type": "string", "format": "uri"},
    "form_type": {"type": "string"},
    "environments": {
      "type": "object",
      "properties": {
        "A": {"$ref": "#/definitions/environment"},
        "B": {"$ref": "#/definitions/environment"},
        "C": {"$ref": "#/definitions/environment"}
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "run_sequence": {"type": "array", "items": {"type": "string"}}
  },
  "definitions": {
    "environment": {
      "type": "object",
      "properties": {
        "label": {"type": "string"},
        "description": {"type": "string"}
      }
    }
  }
}