# Environment variables for ai-bridge.
# Copy to .env.local (gitignored) and fill in real values, or set these in
# your shell/CI environment directly. See SETUP.md for the full
# Keychain/1Password seeding options — env vars are only the first of four
# resolution sources tools/lib/resolve-credential.cjs tries.

# OpenRouter API key. Enables adapters/openrouter.js to dispatch to any openrouter:<vendor>/<model> mind. Without it, the openrouter provider is skipped (routing falls through to other providers in the chain).
OPENROUTER_API_KEY= (optional)

# API key for the generic OpenAI-compatible chat-completions adapter (adapters/openai-compatible.js) — OpenAI itself, or any compatible gateway pointed at via OPENAI_COMPAT_BASE_URL / OPENAI_BASE_URL. Not required for a no-auth local gateway.
OPENAI_API_KEY= (optional)

# Google Gemini API key for adapters/gemini-api.js (text/image REST dispatch).
GEMINI_API_KEY= (optional)
