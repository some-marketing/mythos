<mujoco model="ant-hive-world-embodiment-s2-bridge">
  <!-- tools/ant-hive-world/embodiment-bridge/bridge_scene.xml -- plan
       ant-hive-world-embodiment-s2-bridge, S2.

       Derived from ../embodiment/scene.xml (embodiment-s1, unmodified,
       kept as-is) -- same ground plane and free-jointed sphere body -- plus
       ONE new static target marker body representing "food" for the
       perception/reward mapping's distance_to_target. The target has no
       joint (fixed in the world) and no mass -- it is a landmark, not a
       simulated object, per S0's Decision 1 scoping. -->

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <worldbody>
    <light name="light" pos="0 0 3" dir="0 0 -1" diffuse="1 1 1"/>
    <geom name="ground" type="plane" size="2 2 0.1" rgba="0.5 0.5 0.5 1" solref="0.005 1"/>

    <body name="ant_placeholder" pos="0 0 0.75">
      <freejoint name="ant_placeholder_free"/>
      <geom name="ant_placeholder_geom" type="sphere" size="0.05" rgba="0.8 0.3 0.1 1" mass="0.01" solref="0.005 1"/>
    </body>

    <!-- Fixed target ("food") marker: 0.5m away on the ground plane, within
         the body's eventual reach after settling. No joint = static,
         world-fixed. contype/conaffinity 0 = no physical collision with
         the ant body (a landmark, not an obstacle). -->
    <body name="target_marker" pos="0.5 0 0.02">
      <geom name="target_marker_geom" type="sphere" size="0.02" rgba="0.1 0.8 0.1 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
