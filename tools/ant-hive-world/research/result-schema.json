{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch_id",
    "experiment_sha256",
    "state",
    "invariants",
    "research_complete",
    "promotion",
    "analysis",
    "next_goal_proposal"
  ],
  "properties": {
    "schema": {
      "const": "ResearchResult/1.0"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "experiment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "enum": [
        "not_ready",
        "invalid_experiment",
        "valid_benefit_demonstrated",
        "valid_benefit_not_demonstrated",
        "valid_inconclusive",
        "not_evaluated"
      ]
    },
    "invariants": {
      "enum": [
        "pass",
        "fail",
        "not_evaluated"
      ]
    },
    "research_complete": {
      "type": "boolean"
    },
    "promotion": {
      "const": false
    },
    "analysis": {
      "type": [
        "object",
        "null"
      ]
    },
    "next_goal_proposal": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
