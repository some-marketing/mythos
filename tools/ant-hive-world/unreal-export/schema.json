{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mythos/ant-hive-world/unreal-export/unreal-import/1.0",
  "title": "UnrealImport/1.0",
  "description": "Per-turn import document consumed by the Unreal-side timelapse renderer. Frozen per the unreal-world-projection plan S0 contract (six codex review rounds): a read-only projection derived from a harvested ant-hive-world turn (world-state.json + turn-projection.json + the host-side manifest chain). Never a live channel into a running guest -- input is always a post-turn, courier-crossed harvest directory already on disk.",
  "type": "object",
  "required": ["schema", "turn_id", "source", "derived", "provenance", "advisory"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "UnrealImport/1.0",
      "description": "Fixed schema identifier for this document shape."
    },
    "turn_id": {
      "type": "string",
      "minLength": 1,
      "description": "turn-projection.json's run_name -- the stable identifier for this turn across re-imports."
    },
    "source": {
      "type": "object",
      "description": "Fields read directly from world-state.json for this turn, structurally unchanged from the harvested projection (no derivation applied here -- see `derived` for computed fields).",
      "required": [
        "geometry_log",
        "resources",
        "prey_population",
        "predator_population",
        "territory",
        "food_source_coords",
        "seq",
        "complete",
        "written_at",
        "schema_version"
      ],
      "additionalProperties": true,
      "patternProperties": {
        "^[a-z]+_sources$": {
          "type": "object",
          "description": "A discrete resource-source map (e.g. food_sources, wood_sources, clay_sources): tileId -> remaining amount.",
          "additionalProperties": { "type": "number" }
        }
      },
      "properties": {
        "geometry_log": {
          "type": "array",
          "description": "Raw build events as recorded by world-state.js appendGeometry -- the source the `derived.build_ledger` is computed from.",
          "items": {
            "type": "object",
            "required": ["hive", "kind", "coords", "tick", "run_id", "episode_id"],
            "additionalProperties": true,
            "properties": {
              "hive": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "coords": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": { "type": "number" }
              },
              "tick": { "type": "integer", "minimum": 0 },
              "run_id": { "type": "string", "minLength": 1 },
              "episode_id": { "type": "string", "minLength": 1 },
              "state_at_event": { "type": ["object", "null"] },
              "at": { "type": "string" }
            }
          }
        },
        "resources": {
          "type": "object",
          "description": "Shared resource pool. S0 fixes this to exactly the eight materials the fixtures carry.",
          "required": ["clay", "fiber", "food", "mud", "ore", "stone", "water", "wood"],
          "additionalProperties": true,
          "properties": {
            "clay": { "type": "number" },
            "fiber": { "type": "number" },
            "food": { "type": "number" },
            "mud": { "type": "number" },
            "ore": { "type": "number" },
            "stone": { "type": "number" },
            "water": { "type": "number" },
            "wood": { "type": "number" }
          }
        },
        "prey_population": { "type": "number" },
        "predator_population": { "type": "number" },
        "territory": {
          "type": "object",
          "description": "tileId -> owning hive identity.",
          "additionalProperties": { "type": "string" }
        },
        "food_source_coords": {
          "type": "object",
          "description": "tileId -> [x, y, z] grid coords for discrete food patches.",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": { "type": "number" }
          }
        },
        "seq": { "type": "integer", "minimum": 0 },
        "complete": { "const": true },
        "written_at": { "type": ["string", "null"] },
        "schema_version": { "type": "string", "minLength": 1 }
      }
    },
    "derived": {
      "type": "object",
      "description": "Fields the importer computes from `source` -- never present verbatim in world-state.json.",
      "required": ["build_ledger", "mirror"],
      "additionalProperties": false,
      "properties": {
        "build_ledger": {
          "type": "array",
          "description": "geometry_log mapped into the shape the Unreal renderer spawns actors from.",
          "items": {
            "type": "object",
            "required": ["hive", "kind", "coords", "tick", "run_id", "episode_id", "state_at_event"],
            "additionalProperties": false,
            "properties": {
              "hive": { "type": "string" },
              "kind": { "type": "string" },
              "coords": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": { "type": "number" }
              },
              "tick": { "type": "integer", "minimum": 0 },
              "at": { "type": ["string", "null"] },
              "run_id": { "type": "string" },
              "episode_id": { "type": "string" },
              "state_at_event": { "type": ["object", "null"] }
            }
          }
        },
        "mirror": {
          "description": "Deterministic re-derivation of mirror-detector.js's permutation-null gate, using the importer's own seeded PRNG instead of Math.random so any reviewer can reproduce the p-value byte-for-byte. Null when geometry_log is empty.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": [
                "observed",
                "null_mean",
                "null_sd",
                "p_value",
                "n_builds",
                "n_features",
                "distinct_tiles",
                "seed",
                "shuffles"
              ],
              "additionalProperties": false,
              "properties": {
                "observed": { "type": ["number", "null"] },
                "null_mean": { "type": ["number", "null"] },
                "null_sd": { "type": ["number", "null"] },
                "p_value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                "n_builds": { "type": "integer", "minimum": 0 },
                "n_features": { "type": "integer", "minimum": 0 },
                "distinct_tiles": { "type": "integer", "minimum": 0 },
                "seed": { "type": "integer", "minimum": 0 },
                "shuffles": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Boundary receipts: what turn this is, how many ticks it spans, where it sits in the cumulative timelapse day sequence, and the hash chain proving it crossed the courier/staging/pull boundary unmodified.",
      "required": ["turn_id", "ticks", "absolute_day_start", "payload_hash", "receipts"],
      "additionalProperties": false,
      "properties": {
        "turn_id": { "type": "string", "minLength": 1 },
        "ticks": { "type": "integer", "minimum": 0 },
        "absolute_day_start": {
          "type": "integer",
          "minimum": 0,
          "description": "Cumulative day offset this turn starts at, fixed at first ingestion (see import-index.jsonl) and immutable thereafter."
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 over the sorted (relative-path, sha256) pairs for world-state.json and turn-projection.json as verified against RESULT-MANIFEST.txt. Stable across re-imports of the same harvest directory; used as the freeze/verify key in import-index.jsonl."
        },
        "receipts": {
          "type": "array",
          "description": "One entry per (manifest, file) pair checked while verifying this turn's source files crossed the manifest chain (RESULT-MANIFEST.txt -> HARVEST-MANIFEST.txt -> PULL-MANIFEST.txt) unmodified.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["manifest", "file", "sha256"],
            "additionalProperties": false,
            "properties": {
              "manifest": { "type": "string", "minLength": 1 },
              "file": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "advisory": {
      "type": "object",
      "description": "Carried verbatim from turn-projection.json -- advisory only, never authoritative for rendering decisions.",
      "required": ["mind_state", "resume_continuity"],
      "additionalProperties": false,
      "properties": {
        "mind_state": { "type": ["string", "null"] },
        "resume_continuity": { "type": ["boolean", "null"] }
      }
    }
  }
}
