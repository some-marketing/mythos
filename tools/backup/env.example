# Environment variables for backup.
# Copy to .env.local (gitignored) and fill in real values, or set these in
# your shell/CI environment directly. See SETUP.md for the full
# Keychain/1Password seeding options — env vars are only the first of four
# resolution sources tools/lib/resolve-credential.cjs tries.

# rclone remote name pointing at your Internxt (or any other rclone-compatible) account, as configured via `rclone config`. Not a secret — it's a label, not a token. Scripts default to 'myremote' when unset.
INTERNXT_REMOTE_NAME= (optional)

# Top-level folder/bucket prefix within the remote where backups are stored (e.g. 'backups'). Scripts default to 'backups' when unset.
BACKUP_BUCKET_PREFIX= (optional)

# Directory (relative to repo root, or absolute) that internxt-mind-delta.sh / internxt-mind-full.sh watch and snapshot. Scripts default to 'backup-source' when unset.
BACKUP_SOURCE_DIR= (optional)

# macOS Keychain account name under which your age private key is stored. Used by internxt-restore.sh and rotate-age-key.cjs to look the key up with `security find-generic-password`. Defaults to 'backup-tool'. Seed it with tools/boot/keychain-store.sh.
AGE_KEYCHAIN_ACCOUNT= (optional)

# macOS Keychain service name under which your age private key is stored. Defaults to 'backup-age-key-v2'. Seed it with tools/boot/keychain-store.sh.
AGE_KEYCHAIN_SERVICE= (optional)
