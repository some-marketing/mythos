{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bundle-input.schema.json",
  "title": "Bundle Input",
  "description": "Input manifest for generate-handoff-bundle.js — describes what to include in the bundle",
  "type": "object",
  "required": ["mode", "recipient", "scope", "runs"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["create", "append"],
      "description": "create = new bundle, append = add runs to existing bundle"
    },
    "existing_bundle_path": {
      "type": "string",
      "description": "Required when mode=append. Path to the existing bundle directory."
    },
    "overwrite_policy": {
      "type": "boolean",
      "default": false,
      "description": "When mode=append, allow overwriting existing run evidence folders."
    },
    "recipient": {
      "type": "string",
      "description": "Developer receiving the bundle (e.g. '{DEVELOPER_NAME}')"
    },
    "scope": {
      "type": "string",
      "description": "Human-readable scope description (e.g. '5 testcases, 5 runs — CLIENTA pipeline')"
    },
    "project_root": {
      "type": "string",
      "description": "Absolute path to the repo root. Defaults to cwd."
    },
    "changelog": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PRESENT", "ABSENT"]
        },
        "path": {
          "type": "string",
          "description": "Path to the dev changelog file (relative to project root)"
        },
        "note": {
          "type": "string",
          "description": "Context about the changelog (e.g. date, scope of changes)"
        }
      },
      "required": ["status"]
    },
    "stakeholder_gate": {
      "type": "object",
      "properties": {
        "triggered": { "type": "boolean" },
        "items_total": { "type": "integer", "minimum": 0 },
        "items_answered": { "type": "integer", "minimum": 0 },
        "items_categorized_issue": { "type": "integer", "minimum": 0 },
        "items_categorized_note": { "type": "integer", "minimum": 0 },
        "answers_content": {
          "type": "string",
          "description": "Markdown content for raw/stakeholder_answers.md"
        }
      },
      "required": ["triggered"]
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["testcase_id", "run_id", "env", "form_id"],
        "properties": {
          "testcase_id": { "type": "string" },
          "run_id": { "type": "string" },
          "env": {
            "type": "string",
            "description": "Primary environment used for payload analysis (A, B, or C)"
          },
          "form_id": {
            "type": "string",
            "description": "WPForms form ID (e.g. '88652')"
          },
          "crm_table": {
            "type": "string",
            "description": "Target CRM table (e.g. 'crd99_crmstagings')"
          },
          "form_type": {
            "type": "string",
            "description": "Form type descriptor (e.g. 'credit_application', 'contact_us')"
          },
          "evidence_dir": {
            "type": "string",
            "description": "Absolute path to the runset evidence directory (contains A-logged_out/, B-logged_in/, C-incognito/)"
          },
          "sent_payload_path": {
            "type": "string",
            "description": "Absolute path to the actual sent payload JSON for the primary env"
          },
          "expected_payload_path": {
            "type": "string",
            "description": "Absolute path to the expected_payload.json"
          },
          "wpforms_csv_path": {
            "type": "string",
            "description": "Absolute path to the WPForms export CSV"
          },
          "crm_csv_path": {
            "type": "string",
            "description": "Absolute path to the CRM export CSV"
          },
          "expected_outcomes_path": {
            "type": "string",
            "description": "Absolute path to EXPECTED_OUTCOMES.md"
          }
        }
      }
    }
  },
  "if": {
    "properties": { "mode": { "const": "append" } }
  },
  "then": {
    "required": ["existing_bundle_path"]
  }
}
