# channels/ -- iMessage ingestion + outbound-draft tooling.
# No API keys required (everything runs against macOS Contacts.app + iMessage
# locally via osascript/AppleScript). One optional override:

# Dart board name used as the default forward target for synced contacts and
# the intake-board forwarder. Default if unset: "<your-dartboard-name>/Tasks"
INBOX_DARTBOARD=
