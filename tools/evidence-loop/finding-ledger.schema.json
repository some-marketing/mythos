{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythos.local/schemas/evidence-loop-finding-ledger.json",
  "title": "Evidence Loop Finding Ledger",
  "type": "object",
  "required": ["schema", "scope", "producer_family", "max_iterations", "findings"],
  "properties": {
    "schema": { "const": "EvidenceLoopFindingLedger/1.0" },
    "scope": { "type": "string", "minLength": 1 },
    "producer_family": { "type": "string", "minLength": 1 },
    "max_iterations": { "type": "integer", "minimum": 1, "maximum": 5 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "producer_family", "reviewer_family", "evidence", "research_disposition", "privacy_status", "answer", "next_action", "status", "iteration_count", "supersedes", "superseded_by"],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["CRITICAL", "MAJOR", "MINOR", "NOTE"] },
          "producer_family": { "type": "string", "minLength": 1 },
          "reviewer_family": { "type": "string", "minLength": 1 },
          "context_family": { "type": ["string", "null"] },
          "context_check_required": { "type": "boolean" },
          "evidence": { "type": "array", "minItems": 1 },
          "research_disposition": { "enum": ["internal_evidence", "public_web", "private_prohibited", "operator_only", "superseded", "blocked"] },
          "privacy_status": { "enum": ["safe_for_web", "redacted_for_web", "web_prohibited"] },
          "research_substrate": { "type": ["string", "null"] },
          "query_artifact": { "type": ["string", "null"] },
          "sources": { "type": "array" },
          "answer": { "type": "string" },
          "next_action": { "type": "string" },
          "status": { "enum": ["open", "in_review", "resolved", "deferred", "superseded", "blocked"] },
          "iteration_count": { "type": "integer", "minimum": 0 },
          "supersedes": { "type": "array", "items": { "type": "string" } },
          "superseded_by": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
