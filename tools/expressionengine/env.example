# Bring-your-own ExpressionEngine site. Copy to .env (or export in your shell)
# and fill in your own site's values. All three are optional if you'd rather
# resolve credentials via 1Password (see creds.config.json / README.md) --
# when all three env vars are set, they take priority over 1Password.

EE_URL=https://www.your-site.example/admin.php?/cp/login
EE_USERNAME=your-cp-username
EE_PASSWORD=your-cp-password
