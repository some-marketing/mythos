{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"compiler-observation.schema.json","title":"CompilerObservation/1.0","type":"object",
  "required":["schema","observation_id","plan_id","run_id","plan_sha256","state","exact_identity","divergences","false_blocks","displaced_tokens","framework_denominator","falsification_cases","semantic_acceptance","operator_acceptance","execution_authority"],
  "properties":{
    "schema":{"const":"CompilerObservation/1.0"},"observation_id":{"pattern":"^fco_[a-f0-9]{24}$"},"plan_id":{"pattern":"^frp_[a-f0-9]{24}$"},"run_id":{"type":"string","minLength":1},"plan_sha256":{"pattern":"^[a-f0-9]{64}$"},"state":{"enum":["observe_match","observe_divergence","evidence_missing","review_required"]},"exact_identity":{"type":"boolean"},
    "divergences":{"type":"array","items":{"type":"object","required":["type","node_id","expected","observed","requires_semantic_review"],"properties":{"type":{"type":"string","minLength":1},"node_id":{"type":["string","null"]},"expected":{"type":["string","null"]},"observed":{"type":["string","null"]},"requires_semantic_review":{"type":"boolean"}},"additionalProperties":false}},
    "false_blocks":{"type":"array","items":{"type":"object","required":["reason","evidence_sha256","review_status"],"properties":{"reason":{"type":"string","minLength":1},"evidence_sha256":{"pattern":"^[a-f0-9]{64}$"},"review_status":{"enum":["unverified","confirmed","rejected"]}},"additionalProperties":false}},
    "displaced_tokens":{"type":"object","required":["existing_path_model_tokens","compiler_tool_tokens","fallback_tokens","reviewer_tokens","witnessed","savings_claim_allowed"],"properties":{"existing_path_model_tokens":{"type":["integer","null"],"minimum":0},"compiler_tool_tokens":{"type":"integer","minimum":0},"fallback_tokens":{"type":["integer","null"],"minimum":0},"reviewer_tokens":{"type":["integer","null"],"minimum":0},"witnessed":{"type":"boolean"},"savings_claim_allowed":{"const":false}},"additionalProperties":false},
    "framework_denominator":{"type":"object","required":["state","source_sha256","registered_ids","observed_ids","exclusions"],"properties":{"state":{"enum":["not_supplied","enumerated"]},"source_sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"registered_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"observed_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"exclusions":{"type":"array","items":{"type":"object","required":["id","reason"],"properties":{"id":{"type":"string"},"reason":{"type":"string"}},"additionalProperties":false}}},"additionalProperties":false},
    "falsification_cases":{"type":"array","items":{"type":"object","required":["case","state"],"properties":{"case":{"enum":["cycle","hash_drift","unavailable_requirement","boundary_escape","parallel_write_overlap","semantic_branch","missing_closeout"]},"state":{"enum":["blocked","detected","review_required"]}},"additionalProperties":false},"uniqueItems":true},
    "semantic_acceptance":{"const":"not_evaluated"},"operator_acceptance":{"const":"not_evaluated"},"execution_authority":{"const":false}
  },"additionalProperties":false
}
