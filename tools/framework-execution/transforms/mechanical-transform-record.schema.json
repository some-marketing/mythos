{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mechanical-transform-record.schema.json",
  "title": "MechanicalTransformRecord/1.0",
  "type": "object",
  "required": ["schema", "record_id", "transform", "state", "source_refs", "input_sha256", "observation", "reason", "semantic_acceptance", "operator_acceptance"],
  "properties": {
    "schema": { "const": "MechanicalTransformRecord/1.0" },
    "record_id": { "type": "string", "pattern": "^mtr_[a-f0-9]{24}$" },
    "transform": { "enum": ["source_inventory", "exact_comparator", "count_reconciler"] },
    "state": { "enum": ["exact", "mismatch", "unknown", "unsupported"] },
    "source_refs": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
    "input_sha256": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "observation": {},
    "reason": { "type": ["string", "null"] },
    "semantic_acceptance": { "const": "not_evaluated" },
    "operator_acceptance": { "const": "not_evaluated" }
  },
  "additionalProperties": false
}
