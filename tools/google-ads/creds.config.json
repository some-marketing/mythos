{
  "_comment": "Documents the credential fields these scripts need, in the shared BYO-credential shape (envVar/keychainService/keychainAccount/opVault/opItem/opField) for future wiring to tools/lib/resolve-credential.cjs. Today these are resolved directly by tools/mcp/google-ads/config.js via plain environment variables (see env.example) -- that existing working pattern is left in place rather than rewired ahead of the shared resolver landing.",
  "fields": {
    "GOOGLE_ADS_DEVELOPER_TOKEN": {
      "envVar": "GOOGLE_ADS_DEVELOPER_TOKEN",
      "keychainService": "google-ads",
      "keychainAccount": "developer-token",
      "opVault": "Automation",
      "opItem": "google-ads-api",
      "opField": "developer_token"
    },
    "GOOGLE_ADS_CLIENT_ID": {
      "envVar": "GOOGLE_ADS_CLIENT_ID",
      "keychainService": "google-ads",
      "keychainAccount": "client-id",
      "opVault": "Automation",
      "opItem": "google-ads-api",
      "opField": "client_id"
    },
    "GOOGLE_ADS_CLIENT_SECRET": {
      "envVar": "GOOGLE_ADS_CLIENT_SECRET",
      "keychainService": "google-ads",
      "keychainAccount": "client-secret",
      "opVault": "Automation",
      "opItem": "google-ads-api",
      "opField": "client_secret"
    },
    "GOOGLE_ADS_REFRESH_TOKEN": {
      "envVar": "GOOGLE_ADS_REFRESH_TOKEN",
      "keychainService": "google-ads",
      "keychainAccount": "refresh-token",
      "opVault": "Automation",
      "opItem": "google-ads-api",
      "opField": "refresh_token"
    },
    "GOOGLE_ADS_LOGIN_CUSTOMER_ID": {
      "envVar": "GOOGLE_ADS_LOGIN_CUSTOMER_ID",
      "keychainService": null,
      "keychainAccount": null,
      "opVault": "Automation",
      "opItem": "google-ads-api",
      "opField": "login_customer_id"
    }
  }
}
