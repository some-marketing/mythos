{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythos.local/schemas/actor-work-lease.schema.json",
  "title": "ActorWorkLease/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "work_unit_id", "bounded_artifacts", "status", "epoch", "current_lease", "updated_at"],
  "properties": {
    "schema": { "const": "ActorWorkLease/1.0" },
    "work_unit_id": { "type": "string", "minLength": 1 },
    "bounded_artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["available", "active", "handed_off", "completed", "expired", "abandoned", "reclaimed", "conflicting"] },
    "epoch": { "type": "integer", "minimum": 0 },
    "current_lease": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["lease_id", "actor", "started_at", "heartbeat_at", "expires_at"],
          "properties": {
            "lease_id": { "type": "string", "minLength": 1 },
            "actor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["invocation_id", "session_id", "provenance"],
              "properties": {
                "invocation_id": { "type": "string", "minLength": 1 },
                "session_id": { "type": "string", "minLength": 1 },
                "provenance": { "type": "object" }
              }
            },
            "started_at": { "type": "string", "format": "date-time" },
            "heartbeat_at": { "type": "string", "format": "date-time" },
            "expires_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
