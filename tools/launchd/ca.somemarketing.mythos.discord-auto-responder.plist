<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ca.somemarketing.mythos.discord-auto-responder</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/admin/mythos/tools/launchd/lib/run-with-root.sh</string>
        <string>tools/mcp/discord/run-auto-responder.sh</string>
    </array>

    <!-- Persistently running service. launchd restarts on crash. -->
    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart quickly on crash, but throttle if it keeps dying -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/admin/mythos/_dev/state/discord-auto-responder/launchd.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/admin/mythos/_dev/state/discord-auto-responder/launchd.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/admin</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/admin/.bun/bin</string>
        <key>DISCORD_LLM_MODEL</key>
        <string>deepseek/deepseek-v4-pro</string>
        <key>DISCORD_STATE_DIR</key>
        <string>/Users/admin/.claude/channels/discord</string>
    </dict>
</dict>
</plist>
