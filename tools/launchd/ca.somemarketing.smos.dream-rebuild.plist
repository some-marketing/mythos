<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ca.somemarketing.smos.dream-rebuild</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>node</string>
        <string>/Users/admin/dev/SM_OS-recovered/tools/memory/build-memory-db.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/admin/dev/SM_OS-recovered</string>

    <!-- Daily rebuild at 3:00 AM — deterministic, ~1-2s runtime, idempotent. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/admin/dev/SM_OS-recovered/_dev/state/memory-db/launchd.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/admin/dev/SM_OS-recovered/_dev/state/memory-db/launchd.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/admin</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
