<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ca.somemarketing.smos.harness-capability-crawler</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>node</string>
        <string>/Users/admin/dev/SM_OS-recovered/tools/launchd/run-harness-capability-crawler.cjs</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/admin/dev/SM_OS-recovered</string>

    <!-- Every 15 minutes: report-only capability inventory + next-action queue. -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/admin/dev/SM_OS-recovered/_dev/state/harness-capability-crawler/launchd.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/admin/dev/SM_OS-recovered/_dev/state/harness-capability-crawler/launchd.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/admin</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
