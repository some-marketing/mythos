<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Langfuse exporter daemon. Wakes every 30 minutes, reads _dev/reports/telemetry/
  dispatches.jsonl, and pushes any new cascade traces to the Langfuse instance
  at LANGFUSE_HOST. Mirrors ca.somemarketing.smos.delesign-poll.plist in shape.

  OFF BY DEFAULT — this plist is build-ready but NOT enabled. Enabling is an
  explicit operator action recorded in README-export-daemon.md.

  Trustworthiness evidence for promotion (Learning-and-Automation rule):
    - Manual export (run-export-with-op.sh) has been run successfully N times.
    - Idempotency verified: re-running on already-exported traces produces
      no duplicate Langfuse spans (content-stable span IDs).
    - See README-export-daemon.md: "Trustworthiness Evidence" section.

  VPS INSTALL (operator action — NOT part of /run-plan):
    scp tools/launchd/ca.somemarketing.smos.langfuse-export.plist ubuntu@<VPS>:~/Library/LaunchAgents/
    # (or copy to the VPS and adapt for Linux systemd — see README)
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ca.somemarketing.smos.langfuse-export.plist

  Reload after edit:
    launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/ca.somemarketing.smos.langfuse-export.plist
    cp tools/launchd/ca.somemarketing.smos.langfuse-export.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ca.somemarketing.smos.langfuse-export.plist

  Status / manual kick:
    launchctl print gui/$(id -u)/ca.somemarketing.smos.langfuse-export
    launchctl kickstart -k gui/$(id -u)/ca.somemarketing.smos.langfuse-export

  Stop (STOP PATH 1 — launchd unload):
    launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/ca.somemarketing.smos.langfuse-export.plist

  Stop (STOP PATH 2 — kill-switch):
    touch /Users/admin/dev/SM_OS-recovered/_dev/state/kill-switches/langfuse-export.off
    # Resume:
    rm /Users/admin/dev/SM_OS-recovered/_dev/state/kill-switches/langfuse-export.off

  Interval knob:
    Default: 1800s (30 min) — matches delesign-poll cadence.
    Telemetry-freshness vs VPS-load tradeoff: open for codex review (see plan S2).
    To change: edit StartInterval below and reload.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ca.somemarketing.smos.langfuse-export</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/admin/dev/SM_OS-recovered/tools/telemetry/dispatches/run-export-daemon.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/admin/dev/SM_OS-recovered</string>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/admin/dev/SM_OS-recovered/_dev/state/langfuse-export/launchd.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/admin/dev/SM_OS-recovered/_dev/state/langfuse-export/launchd.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/admin</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>LANGFUSE_HOST</key>
        <string>http://100.78.143.72:3000</string>
    </dict>
</dict>
</plist>
