<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  env-path-hardening followup (2026-05-19):
  Repointed from /Users/admin/Documents/GitHub/SM_OS (abandoned path) to the
  canonical checkout /Users/admin/dev/SM_OS-recovered. The currently loaded
  launchd job still references the old path; operator must bootout/bootstrap
  to pick up this update:
    launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/ca.somemarketing.smos.meta-ads-tracker-refresh-ech.plist
    cp tools/launchd/ca.somemarketing.smos.meta-ads-tracker-refresh-ech.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ca.somemarketing.smos.meta-ads-tracker-refresh-ech.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ca.somemarketing.smos.meta-ads-tracker-refresh-ech</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>node</string>
        <string>/Users/admin/dev/SM_OS-recovered/tools/launchd/run-meta-ads-tracker-refresh.cjs</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/admin/dev/SM_OS-recovered</string>

    <!-- Mondays 09:03 local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>3</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/admin/dev/SM_OS-recovered/_dev/state/meta-ads-tracker/refresh.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/admin/dev/SM_OS-recovered/_dev/state/meta-ads-tracker/refresh.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/admin</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>META_ADS_DRY_RUN</key>
        <string>false</string>
    </dict>
</dict>
</plist>
