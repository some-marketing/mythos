# Personal-account glue -- local IMAP/Google Home scripts. Use Gmail/Google
# app passwords (myaccount.google.com -> Security -> 2-Step -> App passwords),
# never your real account password.

GMAIL_FETCH_EMAIL=
GMAIL_FETCH_APP_PASSWORD=

GOOGLE_HOME_EMAIL=
GOOGLE_HOME_APP_PASSWORD=

# Optional: point at a local secrets file instead of using the vars above
# directly (see lib/instance-secrets.js). Default: secrets/mythos.home.env
MYTHOS_HOME_SECRET_FILE=
