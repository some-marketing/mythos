    "MOXIE_BASE_URL": {
      "envVar": "MOXIE_BASE_URL",
      "keychainService": "mythos-moxie-base-url",
      "keychainAccount": "mythos",
      "opVault": "Automation",
      "opItem": "mythos-moxie-api-credentials",
      "opField": [
        "MOXIE_BASE_URL",
        "base url",
