# CRM MCP lane — example env. Placeholders only. DO NOT commit real values.
#
# For production runs, prefer the 1Password resolver (credential bytes never
# land on disk):
#   tools/mcp/crm/run-with-op.sh node <your-script>.js
#
# The 1Password item is confirmed: item `mythos-moxie-api-credentials`,
# vault `Automation`. The exact FIELD LABELS on that item are UNCONFIRMED —
# see run-with-op.sh header comment. Defaults below match this scaffold's
# best-guess env-var/field names (MOXIE_API_KEY, MOXIE_BASE_URL); override
# CRMOP_FIELD_API_KEY / CRMOP_FIELD_BASE_URL if the operator confirms
# different labels at build time.

# Which CRM provider is active. Only "moxie" exists today; the config/
# provider shape supports adding a sibling (honeybook, dubsado, ...) later.
CRM_PROVIDER=moxie

# Dry-run is the default posture for this whole lane. Reads are enabled when
# this is false; the pull runner is meant to run via run-with-op.sh.
CRM_DRY_RUN=true

# Second, independent gate for the WRITE lane (v1.1). A live POST requires BOTH
# CRM_DRY_RUN=false AND CRM_WRITE_ENABLED=true. Defaults false so writes are
# inert. There is no write CLI runner — a live write requires deliberate wiring
# plus per-call operator approval (see README "Write lane").
CRM_WRITE_ENABLED=false

# Moxie is per-workspace: this base URL is NOT publicly discoverable and
# must be retrieved from the operator's own Moxie workspace settings
# (Workspace Settings -> Connected Apps -> Integrations).
MOXIE_BASE_URL=https://podNN.withmoxie.dev/api/public/
MOXIE_API_KEY=replace_me

# Moxie's documented rate limit (confirmed 2026-06-30): 100 requests / 5 min
# per workspace, HTTP 429 on excess. Client retries on 429 with backoff.
MOXIE_RATE_LIMIT_MAX_REQUESTS=100
MOXIE_RATE_LIMIT_WINDOW_MS=300000
MOXIE_MAX_RETRIES=5
MOXIE_RETRY_BASE_DELAY_MS=1000
