# Delesign MCP — example env. Placeholders only. DO NOT commit real values.
#
# For production runs, prefer the 1Password resolver (token never lands on disk):
#   tools/mcp/delesign/run-with-op.sh node tools/mcp/delesign/server.js
#
# Resolver defaults: item "Delesign", vault "{VAULT}", field "credential".
# Override via DELESIGNOP_ITEM / DELESIGNOP_VAULT / DELESIGNOP_FIELD env vars
# if your account uses different names.
DELESIGN_DRY_RUN=true
DELESIGN_BASE_URL=https://api.delesign.com
DELESIGN_API_VERSION=v1
DELESIGN_API_TOKEN=replace_me
