# Meta Ads MCP — example env. Placeholders only. DO NOT commit real values.
#
# For production runs, prefer the 1Password resolver (token never lands on disk):
#   METAOP_ITEM="Example Group BM Meta App" METAOP_VAULT="{VAULT}" \
#     tools/mcp/meta-ads/run-with-op.sh node tools/mcp/meta-ads/preflight.js
#
# The legacy single-tenant lane (one ad account per env) is still supported:
# tools fall back to META_AD_ACCOUNT_ID when no ad_account_id is passed at
# call-time. Multi-client through one Meta App: ad account IDs live in
# clients/<CLIENT>/projects/meta-app-integration/project.json, NOT here.
META_ADS_DRY_RUN=true
META_API_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_AD_ACCOUNT_ID=123456789012345
META_ACCESS_TOKEN=replace_me
