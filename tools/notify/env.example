# Environment variables for notify.
# Copy to .env.local (gitignored) and fill in real values, or set these in
# your shell/CI environment directly. See SETUP.md for the full
# Keychain/1Password seeding options — env vars are only the first of four
# resolution sources tools/lib/resolve-credential.cjs tries.

# Twilio Account SID (AC... prefix). Preferred auth pair with Auth Token; can also be discovered at runtime from an API Key pair.
TWILIO_ACCOUNT_SID= (optional)

# Twilio Auth Token, paired with Account SID.
TWILIO_AUTH_TOKEN= (optional)

# Twilio API Key SID (SK... prefix) -- alternative auth to Account SID + Auth Token.
TWILIO_API_KEY_SID= (optional)

# Twilio API Key Secret, paired with TWILIO_API_KEY_SID.
TWILIO_API_KEY_SECRET= (optional)

# Twilio phone number you own (E.164). If unset, tools auto-discover a capable owned number at runtime.
TWILIO_FROM_NUMBER= (optional)

# Your own personal phone number (E.164) -- the notification destination. Never hardcode this; always resolve it.
TWILIO_OPERATOR_PHONE= (optional)
