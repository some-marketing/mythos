{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"plan-execution-cursor.schema.json","title":"PlanExecutionCursor/1.0","type":"object",
  "required":["schema","cursor_id","task_id","state","step_id","classification","reason","plan_sha256","plan_pair_sha256","gate_sha256","evidence_sha256","projection_sha256","envelope","authority","can_execute","can_dispatch","can_mutate_state","operator_acceptance"],
