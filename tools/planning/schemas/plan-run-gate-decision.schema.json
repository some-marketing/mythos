{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanRunGateDecision/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "status", "evaluated_at", "json_sha256", "markdown_sha256", "plan_pair_sha256", "marker_sha256", "reason_codes", "checks", "authority"],
  "properties": {
    "schema": { "type": "string", "enum": ["PlanRunGateDecision/1.0"] },
    "task_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["ready", "blocked"] },
    "evaluated_at": { "type": "string", "minLength": 1 },
    "json_sha256": { "type": ["string", "null"] },
    "markdown_sha256": { "type": ["string", "null"] },
    "plan_pair_sha256": { "type": ["string", "null"] },
    "marker_sha256": { "type": ["string", "null"] },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason_code"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "BYPASSED"] },
          "reason_code": { "type": ["string", "null"] }
        }
      }
    },
    "authority": { "type": "string", "enum": ["run_authorization_only"] }
  }
}
