<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.mythos.cowork-bridge
  ----------------------
  Watches _dev/reports/signals/cowork-out/ inside the SM_OS repo. When a
  new .cowork-request.json appears, fires desktop-cowork-consumer.sh which
  routes the packet through claude headless → /dispatch-bridge → codex.

  Companion design doc: _dev/cowork-sessions/dispatch-bridge-cowork-variant.md
  Companion script:     tools/signals/desktop-cowork-consumer.sh
  Install README:       tools/signals/cowork-bridge-README.md

  IMPORTANT: this is a TEMPLATE. The hard-coded path
    /Users/admin/Documents/GitHub/SM_OS
  matches Taylor's machine. If you (or a future copy) installs this on a
  different machine, edit the WatchPaths and ProgramArguments path before
  running launchctl bootstrap.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mythos.cowork-bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/admin/Documents/GitHub/SM_OS/tools/signals/desktop-cowork-consumer.sh</string>
    </array>

    <!-- Trigger: any change inside cowork-out/ wakes the consumer. -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/admin/Documents/GitHub/SM_OS/_dev/reports/signals/cowork-out</string>
    </array>

    <!-- Single-flight is enforced inside the script via a lock file as well,
         but ThrottleInterval keeps launchd from re-firing on rapid changes. -->
    <key>ThrottleInterval</key>
    <integer>2</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/admin/Documents/GitHub/SM_OS/_dev/logs/cowork-bridge/launchd.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/admin/Documents/GitHub/SM_OS/_dev/logs/cowork-bridge/launchd.stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/admin/Documents/GitHub/SM_OS</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
