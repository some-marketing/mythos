{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "actor-capability-receipt.schema.json",
  "title": "ActorCapabilityReceipt/1.0",
  "type": "object",
  "required": ["schema", "dispatch_id", "work_order_sha256", "target", "model", "mind", "mode", "checks", "ready", "references", "errors"],
  "properties": {
    "schema": { "const": "ActorCapabilityReceipt/1.0" },
    "dispatch_id": { "type": "string", "minLength": 1 },
    "work_order_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "mind": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "checks": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "ready": { "type": "boolean" },
    "references": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
