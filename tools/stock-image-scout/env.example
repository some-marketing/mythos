# Environment variables for stock-image-scout.
# Copy to .env.local (gitignored) and fill in real values, or set these in
# your shell/CI environment directly. See SETUP.md for the full
# Keychain/1Password seeding options — env vars are only the first of four
# resolution sources tools/lib/resolve-credential.cjs tries.

# Depositphotos Partner API key (https://depositphotos.com/api-program.html).
DP_API_KEY=

# Depositphotos account login (email/username) for the API session.
DP_LOGIN_USER=

# Depositphotos account password for the API session.
DP_LOGIN_PASSWORD=

# Optional Unsplash API access key. Without it, scout.cjs falls back to mock results for the unsplash provider.
UNSPLASH_ACCESS_KEY= (optional)
