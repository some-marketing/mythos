# telemetry/dispatches -- Langfuse exporter, optional.
#
# The native _dev/reports/telemetry/dispatches.jsonl append-only log stays
# authoritative regardless of whether you ever configure Langfuse. These vars
# only affect the OPTIONAL Langfuse render-adapter (export-to-langfuse.mjs /
# the export daemon).

# Master switch -- exporter dry-runs (builds + reports, no network write)
# unless this is truthy.
MYTHOS_LANGFUSE_EXPORT=

# Where your Langfuse instance lives. Point this at whatever host runs it --
# localhost, a LAN box, a VPN/tailnet peer, a public Langfuse Cloud project, etc.
TELEMETRY_HOST=localhost
LANGFUSE_HOST=http://${TELEMETRY_HOST}:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional: resolve the two keys above from 1Password instead of env vars
# directly (see run-export-with-op.sh). Defaults shown.
MYTHOS_LANGFUSE_OP_VAULT=Automation
MYTHOS_LANGFUSE_OP_ITEM=mythos-langfuse-api
MYTHOS_LANGFUSE_OP_FIELD_PUBLIC=Public Key
MYTHOS_LANGFUSE_OP_FIELD_SECRET=credential
