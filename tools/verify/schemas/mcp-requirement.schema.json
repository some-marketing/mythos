{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-requirement.schema.json",
  "title": "McpRequirement/1.0",
  "type": "object",
  "required": ["schema", "name", "required", "degraded_allowed"],
  "properties": {
    "schema": { "const": "McpRequirement/1.0" },
    "name": { "type": "string", "minLength": 1 },
    "required": { "type": "boolean" },
    "degraded_allowed": { "type": "boolean" },
    "purpose": { "type": "string" }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "required": { "const": true } } }, "then": { "properties": { "degraded_allowed": { "const": false } } } }
  ]
}
