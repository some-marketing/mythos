{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunEvidenceIndex/1.0",
  "type": "object",
  "required": ["schema", "run_id", "receipt_sha256", "verified_at", "producer", "verifier", "independent_verified", "criteria", "summary", "authority"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "RunEvidenceIndex/1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "receipt_sha256": { "type": "string", "minLength": 71 },
    "verified_at": { "type": "string", "minLength": 1 },
    "producer": { "$ref": "#/$defs/provenance" },
    "verifier": { "$ref": "#/$defs/provenance" },
    "independent_verified": { "type": "boolean" },
    "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } },
    "summary": {
      "type": "object",
      "required": ["criteria_total", "criteria_verified", "criteria_missing", "criteria_unverified"],
      "additionalProperties": false,
      "properties": {
        "criteria_total": { "type": "integer", "minimum": 0 },
        "criteria_verified": { "type": "integer", "minimum": 0 },
        "criteria_missing": { "type": "integer", "minimum": 0 },
        "criteria_unverified": { "type": "integer", "minimum": 0 }
      }
    },
    "authority": { "const": "report_only" }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["actor_id", "harness_id"],
      "additionalProperties": false,
      "properties": {
        "actor_id": { "type": "string", "minLength": 1 },
        "harness_id": { "type": "string", "minLength": 1 }
      }
    },
    "criterion": {
      "type": "object",
      "required": ["criterion_id", "artifact_path", "expected_sha256", "current_sha256", "status", "reason_code"],
      "additionalProperties": false,
      "properties": {
        "criterion_id": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": ["string", "null"] },
        "expected_sha256": { "type": ["string", "null"] },
        "current_sha256": { "type": ["string", "null"] },
        "status": { "enum": ["current_hash_verified", "evidence_missing", "unverified_source_claim"] },
        "reason_code": { "type": ["string", "null"] }
      }
    }
  }
}
