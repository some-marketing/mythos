{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunEvidenceReceipt/1.0",
  "type": "object",
  "required": ["schema", "source_type", "run_id", "run_state_path", "produced_at", "producer", "criteria"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "RunEvidenceReceipt/1.0" },
    "source_type": { "enum": ["generation_receipt", "caller_claim"] },
    "run_id": { "type": "string", "minLength": 1 },
    "run_state_path": { "type": "string", "minLength": 1 },
    "produced_at": { "type": "string", "minLength": 1 },
    "producer": { "$ref": "#/$defs/provenance" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["actor_id", "harness_id"],
      "additionalProperties": false,
      "properties": {
        "actor_id": { "type": "string", "minLength": 1 },
        "harness_id": { "type": "string", "minLength": 1 }
      }
    },
    "criterion": {
      "type": "object",
      "required": ["criterion_id", "status", "reason_code"],
      "additionalProperties": false,
      "properties": {
        "criterion_id": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": ["string", "null"] },
        "artifact_type": { "type": ["string", "null"] },
        "generation_sha256": { "type": ["string", "null"] },
        "status": { "enum": ["snapshotted", "evidence_missing", "unverified_source_claim"] },
        "reason_code": { "type": ["string", "null"] }
      }
    }
  }
}
