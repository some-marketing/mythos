{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mythos Claude Settings",
  "type": "object",
  "required": ["permissions", "hooks"],
  "properties": {
    "permissions": {
      "type": "object",
      "required": ["allow"],
      "properties": {
        "allow": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "hooks": {
      "type": "object",
      "properties": {
        "PreToolUse": { "type": "array", "items": { "$ref": "#/$defs/hookEntry" } },
        "PostToolUse": { "type": "array", "items": { "$ref": "#/$defs/hookEntry" } }
      }
    }
  },
  "$defs": {
    "hookEntry": {
      "type": "object",
      "required": ["matcher", "hooks"],
      "properties": {
        "matcher": { "type": "string", "minLength": 1 },
        "hooks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "command"],
            "properties": {
              "type": { "type": "string" },
              "command": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
