{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerificationSignal v1.0",
  "description": "Strict v1.0 verification contract for autonomy gate validation.",
  "type": "object",
  "required": [
    "schema",
    "timestamp",
    "source",
    "scope",
    "tier",
    "verdict",
    "summary",
    "checks",
    "failures",
    "gate_decision"
  ],
  "properties": {
    "schema": {
      "const": "VerificationSignal/1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "tier": {
      "enum": ["mechanical", "nuance", "combined"]
    },
    "verdict": {
      "enum": ["PASS", "FAIL", "WARN"]
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "warned", "skipped"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "warned": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "severity", "status", "message"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "enum": ["critical", "warning", "info"] },
          "status": { "enum": ["PASS", "FAIL", "WARN", "SKIP"] },
          "message": { "type": "string" },
          "evidence": { "type": "string" },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "message"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "message": { "type": "string" },
          "fix_hint": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "gate_decision": {
      "type": "object",
      "required": ["proceed", "reason"],
      "properties": {
        "proceed": { "type": "boolean" },
        "reason": { "type": "string" },
        "blocked_by": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
