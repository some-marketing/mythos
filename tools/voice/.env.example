# Only ElevenLabs key needed — Claude runs through your local `claude` CLI auth
ELEVENLABS_API_KEY=***
# Optional: voice ID from ElevenLabs (run with --pick-voice to browse)
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# VAD (voice activity detection) settings
# Energy threshold for speech detection (RMS of int16 samples, default 500)
# Lower = more sensitive, higher = less sensitive. Adjust if too many false triggers.
# VAD_ENERGY_THRESHOLD=500
# Seconds of silence before auto-sending (default 1.5)
# VAD_SILENCE_DURATION=1.5
# Minimum recording length in seconds to avoid false triggers (default 0.5)
# VAD_MIN_RECORDING_DURATION=0.5

# ── Discord Voice Callback Settings ─────────────────────
# Required for discord_callback_server.py
# Get bot token from Discord Developer Portal: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=***

# Guild (server) ID - right-click server name in Discord with Developer Mode on
DISCORD_GUILD_ID=123456789012345678

# Voice channel ID - right-click voice channel with Developer Mode on
DISCORD_VOICE_CHANNEL_ID=987654321098765432

# User ID allowed to speak with bot ({OPERATOR_NAME}'s Discord ID)
DISCORD_ALLOWED_USER_ID=111222333444555666

# Rate limiting: seconds between calls (default 120)
# DISCORD_CALL_COOLDOWN=120

# Inactivity timeout before auto-disconnect (default 300)
# DISCORD_INACTIVITY_TIMEOUT=300

# Optional: path to audit log file
# DISCORD_AUDIT_LOG_PATH=logs/discord_voice_audit.jsonl
