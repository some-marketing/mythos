<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mythos.wifi-capture</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO_ROOT__/tools/wifi-capture/watch-ssid.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/_dev/state/wifi-capture.log</string>

    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/_dev/state/wifi-capture.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>POLL_INTERVAL</key>
        <string>15</string>
        <key>DEBOUNCE_SECONDS</key>
        <string>10</string>
        <key>WIFI_INTERFACE</key>
        <string>en0</string>
    </dict>
</dict>
</plist>
