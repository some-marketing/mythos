{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mythos Run State",
  "type": "object",
  "required": ["run_id", "framework_id", "status", "started_at"],
  "properties": {
    "run_id": { "type": "string" },
    "framework_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["running", "completed", "failed"]
    },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "prompt_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prompt_id", "result"],
        "properties": {
          "prompt_id": { "type": "string" },
          "result": { "type": "string" },
          "artifacts": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "artifacts_produced": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "output_validation": { "type": "object" }
  }
}
