{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mythos Signal Entry",
  "description": "Internal system signal from validation, replay, audit, or health checks. Internal signal class.",
  "type": "object",
  "required": [
    "entry_id",
    "signal_type",
    "result",
    "captured_at"
  ],
  "properties": {
    "entry_id": {
      "type": "string",
      "description": "Unique identifier for this signal entry"
    },
    "run_id": {
      "type": "string",
      "description": "Optional reference to a specific run"
    },
    "framework_id": {
      "type": "string",
      "description": "Framework identifier (service/name)"
    },
    "signal_type": {
      "type": "string",
      "enum": [
        "validation",
        "replay",
        "completion_audit",
        "health_check",
        "output_quality",
        "prompt_drift",
        "sanitization",
        "structural_check"
      ],
      "description": "Category of internal signal"
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail", "partial", "advisory"],
      "description": "Signal outcome"
    },
    "details": {
      "type": "string",
      "description": "Human-readable explanation of the signal"
    },
    "metrics": {
      "type": "object",
      "description": "Optional machine-readable metrics (e.g. failure_rate, pass_count)"
    },
    "source": {
      "type": "string",
      "description": "Which tool or process produced this signal"
    },
    "captured_at": {
      "type": "string",
      "description": "ISO 8601 timestamp"
    },
    "produced_by_actor_id": {
      "type": ["string", "null"],
      "description": "Actor ID that produced this signal"
    },
    "produced_by_actor_type": {
      "type": ["string", "null"],
      "enum": ["human", "intelligence", "hybrid", null],
      "description": "Type of the producing actor"
    },
    "produced_by_harness_id": {
      "type": ["string", "null"],
      "description": "Harness ID of the producing actor"
    },
    "produced_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "When the signal was produced"
    },
    "validated_by_actor_id": {
      "type": ["string", "null"],
      "description": "Actor ID that validated this signal for acceptance-grade events"
    },
    "validated_by_actor_type": {
      "type": ["string", "null"],
      "enum": ["human", "intelligence", "hybrid", null],
      "description": "Type of the validating actor"
    },
    "validated_by_harness_id": {
      "type": ["string", "null"],
      "description": "Harness ID of the validating actor"
    },
    "validated_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "When validation occurred"
    },
    "validation_artifact": {
      "type": ["string", "null"],
      "description": "Path to the durable validation artifact"
    },
    "validation_method": {
      "type": ["string", "null"],
      "description": "How validation was performed"
    },
    "validation_confidence": {
      "type": ["string", "null"],
      "enum": ["confirmed", "probable", "uncertain", null],
      "description": "Confidence level of the validation"
    }
  }
}
