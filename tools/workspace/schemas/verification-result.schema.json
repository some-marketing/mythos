{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mythos Verification Result",
  "description": "Structured output contract for the local verifier lane. Every verification dispatch must produce a result matching this schema.",
  "type": "object",
  "required": [
    "workflow_type",
    "verdict",
    "confidence",
    "findings",
    "reason",
    "needs_escalation",
    "escalation_triggers",
    "timestamp"
  ],
  "properties": {
    "workflow_type": {
      "type": "string",
      "const": "verification",
      "description": "Must always be 'verification'"
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "uncertain"],
      "description": "Verification outcome. 'uncertain' requires needs_escalation=true."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score between 0.0 and 1.0. Should be benchmark-calibrated when possible."
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "description": "Structured findings from the verification review."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable explanation of the verdict."
    },
    "needs_escalation": {
      "type": "boolean",
      "description": "Whether the result requires frontier/human review. Must be true when verdict is 'uncertain'."
    },
    "escalation_triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "evidence_missing",
          "evidence_conflicting",
          "confidence_below_threshold",
          "context_too_broad",
          "output_contract_violation",
          "high_risk_override"
        ]
      },
      "description": "Which escalation trigger conditions were met. Required when needs_escalation is true."
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of when the verification was completed."
    },
    "model_id": {
      "type": ["string", "null"],
      "description": "Model identifier used for verification (e.g. 'qwen2.5:14b')."
    },
    "provider": {
      "type": ["string", "null"],
      "description": "Provider name that ran the verification (e.g. 'ollama')."
    },
    "runtime_ms": {
      "type": ["number", "null"],
      "description": "Verification runtime in milliseconds."
    },
    "benchmark_tag": {
      "type": ["string", "null"],
      "description": "Benchmark cohort tag for confidence calibration."
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths to input artifacts that were reviewed."
    },
    "produced_by_actor_id": {
      "type": ["string", "null"],
      "description": "Actor ID that produced the artifact being verified"
    },
    "produced_by_actor_type": {
      "type": ["string", "null"],
      "enum": ["human", "intelligence", "hybrid", null],
      "description": "Type of the producing actor"
    },
    "produced_by_harness_id": {
      "type": ["string", "null"],
      "description": "Harness ID of the producing actor"
    },
    "produced_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "When the artifact was produced"
    },
    "validated_by_actor_id": {
      "type": ["string", "null"],
      "description": "Actor ID that performed this verification"
    },
    "validated_by_actor_type": {
      "type": ["string", "null"],
      "enum": ["human", "intelligence", "hybrid", null],
      "description": "Type of the verifying actor"
    },
    "validated_by_harness_id": {
      "type": ["string", "null"],
      "description": "Harness ID of the verifying actor"
    },
    "validated_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "When validation occurred"
    },
    "validation_artifact": {
      "type": ["string", "null"],
      "description": "Path to the durable validation artifact"
    },
    "validation_method": {
      "type": ["string", "null"],
      "description": "How validation was performed"
    },
    "validation_confidence": {
      "type": ["string", "null"],
      "enum": ["confirmed", "probable", "uncertain", null],
      "description": "Confidence level of the verification"
    }
  },
  "$defs": {
    "Finding": {
      "type": "object",
      "required": ["id", "severity", "message"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique finding identifier."
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "info"],
          "description": "Finding severity level."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable finding description."
        },
        "evidence": {
          "type": ["string", "null"],
          "description": "Supporting evidence text."
        }
      }
    }
  }
}
